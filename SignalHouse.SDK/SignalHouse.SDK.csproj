<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>SignalHouse.SDK</RootNamespace>
    <PackageId>SignalHouseSms.Sdk</PackageId>
    <Version>1.7.0</Version>
    <Authors>Signal House LLC</Authors>
    <Description>Official .NET SDK for the SignalHouse platform</Description>
    <PackageLicenseExpression>ISC</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/signalhouse-sms/sdk-net</RepositoryUrl>
    <PackageProjectUrl>https://github.com/signalhouse-sms/sdk-net</PackageProjectUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <None Include="..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>
</Project>
